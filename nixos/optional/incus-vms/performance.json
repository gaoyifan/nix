                        "editorMode": "code",
                        "expr": "100 * (1 - sum(rate(incus_cpu_seconds_total{job=\"incus\",type=\"virtual-machine\",name=~\"$vm\",mode=\"idle\"}[$__rate_interval])) / sum(rate(incus_cpu_seconds_total{job=\"incus\",type=\"virtual-machine\",name=~\"$vm\"}[$__rate_interval])))",
                        "instant": true,
                        "legendFormat": "CPU",
                        "range": false
