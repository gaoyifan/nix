+
+static void send_selection_utf8(char *text, int len) {
+	int latin1_len = 0;
+	char *latin1 = clipboard_convert(text, len, "ISO-8859-1//TRANSLIT", "UTF-8", &latin1_len);
+	char *wire = malloc((size_t)len * 2 + 1);
+	int i, wire_len = 0;
+	if (!wire) {
+		free(latin1);
+		return;
+	}
+	for (i = 0; i < len; i++) {
+		if (text[i] == '\n' && (i == 0 || text[i-1] != '\r')) {
+			wire[wire_len++] = '\r';
+		}
+		wire[wire_len++] = text[i];
+	}
+	wire[wire_len] = '\0';
+	rfbSendServerCutTextUTF8(screen, wire, wire_len, latin1, latin1_len);
+	free(wire);
+	free(latin1);
+}
