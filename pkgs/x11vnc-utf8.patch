+/* Keep the X11 selection in UTF-8 and convert only at legacy boundaries. */
+char *clipboard_convert(const char *text, int len, const char *to,
+    const char *from, int *converted_len) {
+	iconv_t converter = iconv_open(to, from);
+	size_t capacity = (size_t)len * 2 + 1, input_left = len, output_left = capacity - 1;
+	char *result, *input = (char *)text, *output;
+	if (converter == (iconv_t)-1) {
+		return NULL;
+	}
+	result = malloc(capacity);
+	if (!result) {
+		iconv_close(converter);
+		return NULL;
+	}
+	output = result;
+	while (iconv(converter, &input, &input_left, &output, &output_left) == (size_t)-1) {
+		size_t used = output - result;
+		char *grown;
+		if (errno != E2BIG) {
+			free(result);
+			iconv_close(converter);
+			return NULL;
+		}
+		capacity *= 2;
+		grown = realloc(result, capacity);
+		if (!grown) {
+			free(result);
+			iconv_close(converter);
+			return NULL;
+		}
+		result = grown;
+		output = result + used;
+		output_left = capacity - used - 1;
+	}
+	*output = '\0';
+	*converted_len = output - result;
+	iconv_close(converter);
+	return result;
+}
